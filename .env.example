# --- Site ---------------------------------------------------------------
# URL publique canonique (sitemap, Open Graph, données structurées).
NEXT_PUBLIC_SITE_URL=https://www.exemple.ci

# --- Formulaire de contact (envoi via Resend : https://resend.com) --------
# Sans ces variables, le formulaire n'envoie rien et affiche les coordonnées directes.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info.2bi@gtpci.com
# Expéditeur sur un domaine vérifié dans Resend, ex. "BEST BUILDING IMMOBILIER <site@votre-domaine.ci>"
CONTACT_FROM_EMAIL=

# --- Anti-spam optionnel : Cloudflare Turnstile (gratuit) ----------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WhatsApp (numéro professionnel VALIDÉ uniquement, format international sans + ni espaces) ---
# Exemple : 2250700000000. Laisser vide tant que le numéro n'est pas validé : le bouton reste masqué.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Carte du siège social (à renseigner après confirmation de l'emplacement exact) ---
NEXT_PUBLIC_HQ_LAT=
NEXT_PUBLIC_HQ_LNG=
